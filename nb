#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT"

JOBS=$(nproc 2>/dev/null || echo 4)

prune_orphans() {
  for elf in usr/apps/*.elf usr/bin/*.elf usr/installer/*.elf; do
    [ -e "$elf" ] || continue
    src=${elf%.elf}.c
    [ -e "$src" ] && continue
    rm -f "$elf" "bin/$(basename "${elf%.elf}")" "rootfs/bin/$(basename "${elf%.elf}")"
    echo "pruned $(basename "${elf%.elf}") -- its source is gone"
  done
}

configure() { prune_orphans; sh builder/configure.sh; }

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; }


cervus_abi() {
  awk '/^#define CERVUS_ABI/ {print $3}' usr/sysroot/usr/include/sys/abi.h 2>/dev/null || echo 1
}

herd_manifest() {
  outdir=$1; name=$2; ver=$3; deps=$4; summary=$5; license=$6
  built=${7:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}
  f="$name-$ver-x86_64.tar.gz"
  sz=$(wc -c < "$outdir/$f" | tr -d ' ')
  sha=$(sha256sum "$outdir/$f" | awk '{print $1}')
  cat > "$outdir/$name-$ver-x86_64.manifest" <<MEOF
name: $name
version: $ver
arch: x86_64
size: $sz
sha256: $sha
file: $f
depends: $deps
abi: $(cervus_abi)
built: $built
summary: $summary
license: $license
MEOF
}

pack_tree() {
  outdir=$1; name=$2; ver=$3; shift 3
  stage=$(mktemp -d)
  for dir in "$@"; do
    [ -d "rootfs$dir" ] || continue
    mkdir -p "$stage$(dirname "$dir")"
    cp -a "rootfs$dir" "$stage$(dirname "$dir")/"
  done
  tar -C "$stage" --owner=0 --group=0 --numeric-owner \
      -czf "$outdir/$name-$ver-x86_64.tar.gz" .
  rm -rf "$stage"
}

bump_version() {
  cur=$(cat builder/VERSION 2>/dev/null || echo 0.0.2)
  case "$cur" in
    *.*.*.*) base=${cur%.*}; build=${cur##*.} ;;
    *)       base=$cur;      build=0 ;;
  esac
  case "$build" in
    ''|*[!0-9]*) build=0 ;;
  esac
  printf '%s.%s\n' "$base" "$((build + 1))" > builder/VERSION
  cat builder/VERSION
}

publish_system() {
  keyfile=${HERD_KEY:-$HOME/cervus-keys/herd.pem}
  outdir=${HERD_OUT:-$HOME/herd-packs/out}
  repo=${HERD_GH_REPO:-VeoQeoOrg/herd-packs}
  ver=""
  bump=false
  for a in "$@"; do
    case "$a" in
      --bump) bump=true ;;
      -*)     echo "nb upload: unknown option $a" >&2; exit 1 ;;
      *)      ver=$a ;;
    esac
  done

  [ -f "$keyfile" ] || {
    echo "nb upload: no signing key at $keyfile" >&2
    echo "           only whoever holds it can publish; set HERD_KEY if it lives elsewhere" >&2
    exit 1
  }
  command -v gh >/dev/null 2>&1 || { echo "nb upload: gh is not installed" >&2; exit 1; }
  n=0
  until gh api user >/dev/null 2>&1; do
    n=$((n + 1))
    [ "$n" -ge 5 ] && { echo "nb upload: gh cannot reach GitHub (logged in? run: gh auth login)" >&2; exit 1; }
  done

  if [ -n "$ver" ]; then printf '%s\n' "$ver" > builder/VERSION
  elif $bump;   then ver=$(bump_version)
  else ver=$(cat builder/VERSION 2>/dev/null || echo 0.0.2); fi
  echo "publishing Cervus $ver"

  configure
  ninja -j "$JOBS"
  [ -f bin/kernel ] || { echo "nb upload: bin/kernel was not built" >&2; exit 1; }
  [ -d rootfs ]     || { echo "nb upload: rootfs was not assembled" >&2; exit 1; }

  mkdir -p "$outdir"
  rm -f "$outdir"/kernel-*.tar.gz "$outdir"/kernel-*.manifest \
        "$outdir"/cervus-base-*.tar.gz "$outdir"/cervus-base-*.manifest \
        "$outdir"/cervus-libc-*.tar.gz "$outdir"/cervus-libc-*.manifest \
        "$outdir"/cervus-media-*.tar.gz "$outdir"/cervus-media-*.manifest \
        "$outdir"/cervus-system-*.tar.gz "$outdir"/cervus-system-*.manifest

  pack_tree "$outdir" kernel       "$ver" /boot
  pack_tree "$outdir" cervus-base  "$ver" /bin /apps /usr/share/man
  pack_tree "$outdir" cervus-libc  "$ver" /usr/lib /usr/include
  pack_tree "$outdir" cervus-media "$ver" /usr/share/fonts /usr/share/consolefonts /usr/share/media

  meta=$(mktemp -d); mkdir -p "$meta/var/lib/herd"
  printf 'Cervus %s\n' "$ver" > "$meta/var/lib/herd/system-release"
  tar -C "$meta" --owner=0 --group=0 --numeric-owner \
      -czf "$outdir/cervus-system-$ver-x86_64.tar.gz" .
  rm -rf "$meta"

  sysbuilt=$(sed -n 's/^built: //p' rootfs/var/lib/herd/cervus-system.manifest 2>/dev/null)
  [ -n "$sysbuilt" ] || sysbuilt=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  herd_manifest "$outdir" kernel       "$ver" libc \
      "the Cervus kernel and init, for the boot partition" GPL-3.0 "$sysbuilt"
  herd_manifest "$outdir" cervus-base  "$ver" libc \
      "the Cervus command line: every utility in /bin and /apps" GPL-3.0 "$sysbuilt"
  herd_manifest "$outdir" cervus-libc  "$ver" libc \
      "the Cervus C library, its headers and crt0" GPL-3.0 "$sysbuilt"
  herd_manifest "$outdir" cervus-media "$ver" libc \
      "console and TrueType fonts, wallpapers and sounds" GPL-3.0 "$sysbuilt"
  herd_manifest "$outdir" cervus-system "$ver" "cervus-base cervus-libc cervus-media kernel" \
      "all of Cervus: kernel, command line, library and assets" GPL-3.0 "$sysbuilt"

  ( cd "$outdir" && awk 'FNR==1 && NR!=1 {print ""} {print}' ./*.manifest > INDEX )
  openssl pkeyutl -sign -inkey "$keyfile" -rawin -in "$outdir/INDEX" -out "$outdir/INDEX.sig" || {
    echo "nb upload: signing failed" >&2; exit 1; }

  echo "uploading to $repo"
  for f in $(awk '/^file:/ {print $2}' "$outdir/INDEX") INDEX INDEX.sig; do
    [ -f "$outdir/$f" ] || { echo "nb upload: $f is in the index but not in $outdir" >&2; exit 1; }
    n=0
    until gh release upload index "$outdir/$f" --clobber --repo "$repo" >/dev/null 2>&1; do
      n=$((n + 1))
      [ "$n" -ge 12 ] && { echo "nb upload: giving up on $f after $n attempts" >&2; exit 1; }
      sleep 3
    done
    echo "  $f"
  done

  keep=$(awk '/^file:/ {print $2}' "$outdir/INDEX"; echo INDEX; echo INDEX.sig)
  for a in $(gh release view index --repo "$repo" --json assets --jq '.assets[].name'); do
    printf '%s\n' "$keep" | grep -qxF "$a" && continue
    gh release delete-asset index "$a" --repo "$repo" --yes >/dev/null 2>&1 && echo "  removed $a"
  done

  echo "published Cervus $ver -- 'herd upgrade' on a Cervus machine picks it up"
}

deep_clean() {
  rm -rf obj bin rootfs iso_root data_iso_root demo_iso limine limine-tools \
    edk2-ovmf kernel/linker-scripts .ninja build.ninja builder/.legacy-build
  rm -f initramfs.tar *.tar limine.conf OS-TREE.txt log.txt log_*.txt \
    cervus-dev.log *.log \
    cervus_disk.img cervus_ata.img cervus_sata.img cervus_nvme.img \
    cervus_data.iso Cervus.iso Cervus.hdd temp_*
  rm -f usr/sysroot/usr/lib/libcervus.a usr/sysroot/usr/lib/crt0.o
  rm -rf usr/sysroot/usr/bin
  rm -rf usr/cross/src usr/cross/build
  find usr/lib/libcervus -name '*.o' -delete 2>/dev/null || true
  rm -f usr/lib/libcervus/libcervus.a
  find usr/apps usr/bin usr/installer -name '*.elf' -delete 2>/dev/null || true
}

flash_iso() {
  dev="${1:-}"

  configure
  ninja -j "$JOBS" iso
  iso="demo_iso/Cervus.latest.iso"
  [ -e "$iso" ] || { echo "flash: no ISO at $iso" >&2; exit 1; }
  iso=$(readlink -f "$iso")

  if [ -z "$dev" ]; then
    echo "Removable / USB block devices:"
    echo
    lsblk -d -o NAME,SIZE,TRAN,RM,MODEL 2>/dev/null | awk 'NR==1 || $4==1 || $3=="usb"'
    echo
    echo "Then run:  ./nb flash /dev/sdX     (writes to the WHOLE device, not a partition)"
    exit 1
  fi

  case "$dev" in /dev/*) ;; *) echo "flash: '$dev' is not a /dev path" >&2; exit 1 ;; esac
  [ -b "$dev" ] || { echo "flash: '$dev' is not a block device" >&2; exit 1; }

  name=$(basename "$dev")
  rmv=$(cat "/sys/block/$name/removable" 2>/dev/null || echo 0)
  tran=$(lsblk -dno TRAN "$dev" 2>/dev/null || echo "")
  size=$(lsblk -dno SIZE "$dev" 2>/dev/null || echo "?")
  model=$(lsblk -dno MODEL "$dev" 2>/dev/null || echo "?")

  if [ "$rmv" != "1" ] && [ "$tran" != "usb" ]; then
    echo "flash: '$dev' is not removable (removable=$rmv, tran=$tran)." >&2
    echo "       Refusing to write to a fixed disk. Check the device name." >&2
    exit 1
  fi

  SUDO=""
  [ "$(id -u)" = 0 ] || SUDO="sudo"

  echo
  echo "  Target : $dev  ($size, ${tran:-?}, $model)"
  echo "  Image  : $iso"
  echo
  printf "ALL DATA on %s will be ERASED. Type 'yes' to write: " "$dev"
  read ans
  [ "$ans" = "yes" ] || { echo "aborted."; exit 1; }

  for part in $(lsblk -lno NAME "$dev" 2>/dev/null | tail -n +2); do
    $SUDO umount "/dev/$part" 2>/dev/null || true
  done

  echo "writing..."
  $SUDO dd if="$iso" of="$dev" bs=4M oflag=sync status=progress ||
    $SUDO dd if="$iso" of="$dev" bs=4M
  $SUDO sync
  echo "done -- '$dev' is now bootable Cervus."
}

case "${1:-}" in
deps)
  exec sh builder/deps.sh
  ;;
run)
  shift
  installed=false
  grub=false
  for a in "$@"; do
    [ "$a" = --installed ] && installed=true
    [ "$a" = --grub ] && grub=true
  done
  if ! $installed; then
    configure
    if $grub; then ninja -j "$JOBS" grubiso; else ninja -j "$JOBS" iso; fi
  fi
  exec sh builder/run_qemu.sh "$@"
  ;;
flash)
  shift
  flash_iso "${1:-}"
  ;;
upload)
  shift
  publish_system "$@"
  ;;
clean)
  rm -rf obj bin rootfs iso_root demo_iso .ninja build.ninja
  rm -f initramfs.tar limine.conf
  find usr/apps usr/bin usr/installer -name '*.elf' -delete 2>/dev/null || true
  echo "cleaned (deps/limine kept; cinder lives in /usr/bin; './nb gitclean' for a full wipe)"
  ;;
gitclean)
  deep_clean
  echo "deep clean complete (deps/limine removed too)"
  ;;
cleaniso)
  rm -rf demo_iso
  echo "removed demo_iso/"
  ;;
reconfigure)
  configure
  ;;
help | -h | --help)
  usage
  ;;
"")
  configure
  ninja -j "$JOBS"
  ;;
*)
  configure
  ninja -j "$JOBS" "$@"
  ;;
esac
