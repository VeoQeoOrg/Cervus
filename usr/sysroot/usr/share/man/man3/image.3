NAME
       image - decode and scale images

SYNOPSIS
       #include <image.h>

       int  image_load(const char *path, image_t *out);
       int  image_load_mem(const uint8_t *d, size_t n, const char *hint,
                           image_t *out);
       void image_free(image_t *img);
       image_t image_scale(const image_t *src, int dw, int dh);

       int  gif_decode(const uint8_t *d, size_t n, gif_anim_t *out);
       void gif_free(gif_anim_t *a);

       int  image_decode_png(const uint8_t *d, size_t n, image_t *out);
       int  image_decode_jpeg(const uint8_t *d, size_t n, image_t *out);
       int  image_decode_bmp(const uint8_t *d, size_t n, image_t *out);
       int  image_decode_svg(const uint8_t *d, size_t n, image_t *out);
       int  image_decode_gif(const uint8_t *d, size_t n, image_t *out);

DESCRIPTION
       Decodes PNG, JPEG, BMP, SVG and GIF into an image_t: width,
       height and a buffer of 32-bit pixels.

       gif_decode returns every frame of an animation, already composed
       against the preceding ones, together with the delay of each and
       the loop count. Interlaced images and all the disposal methods
       are handled, so a frame that only stores what changed is
       composed correctly. Frames are held in memory, so a long
       animation costs width by height by four bytes per frame.

       image_scale returns a new image; free it with image_free unless
       it aliases the source.

       The per-format decoders can be called directly when the format
       is already known; image_load picks one by sniffing the data and
       falls back to the file name.

RETURN VALUE
       0 on success, negative when the data cannot be decoded.

SEE ALSO
       img(1), cfm(1), framebuffer(2)
