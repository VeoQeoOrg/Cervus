NAME
       stdio - buffered input and output

SYNOPSIS
       #include <stdio.h>

       FILE  *fopen(const char *path, const char *mode);
       int    fclose(FILE *f);
       size_t fread(void *p, size_t sz, size_t n, FILE *f);
       size_t fwrite(const void *p, size_t sz, size_t n, FILE *f);
       int    fseek(FILE *f, long off, int whence);
       long   ftell(FILE *f);
       char  *fgets(char *s, int n, FILE *f);
       int    fputs(const char *s, FILE *f);
       int    fflush(FILE *f);

       int    fgetc(FILE *f);        int  fputc(int c, FILE *f);
       int    getchar(void);         int  putchar(int c);
       int    puts(const char *s);   int  ungetc(int c, FILE *f);
       int    feof(FILE *f);         int  ferror(FILE *f);
       void   clearerr(FILE *f);     void rewind(FILE *f);
       int    fileno(FILE *f);       FILE *fdopen(int fd, const char *mode);

       #include <unistd.h>
       int    isatty(int fd);

DESCRIPTION
       Buffered streams over file descriptors. stdin, stdout and stderr
       are open at startup.

       isatty reports whether a descriptor is a terminal, which is how a
       program decides between an interactive display and plain output
       for a pipe.

       fileno gives the descriptor behind a stream and fdopen wraps a
       descriptor in one, which is how a program mixes stdio with a
       call that only takes descriptors, such as poll.

       feof and ferror distinguish the end of the input from a failure
       after a short read; clearerr resets both.

       Output is buffered, so anything drawn to the terminal has to be
       flushed before it appears. This matters when a program mixes
       stdio with something unbuffered: a full-screen program that
       writes its text through stdio and then paints the framebuffer
       must flush between the two, or the picture lands under text that
       has not been written yet.

RETURN VALUE
       As usual for C; NULL or a short count with errno set on failure.

SEE ALSO
       printf(3), getline(3), read(2), write(2)
